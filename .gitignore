# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Credentials — NEVER commit
.env
*.env
*.env.*
.oanda_credentials
*_credentials
*_secrets
*.key
*.pem
secrets/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Logs — keep structure but not huge log files
logs/forex/manage-*.log
logs/forex/launchd-*.log
logs/forex/cron-*.log
logs/paper/run-*.log
logs/real/

# Keep journal, verdicts, research, and scan files — these are the agent's memory
# logs/forex/trade_journal.json  ← KEEP (committed)
# logs/forex/*_research.json     ← KEEP
# logs/forex/*_verdicts.json     ← KEEP
# logs/forex/*_scan.json         ← KEEP
# logs/forex/*_trades.json       ← KEEP

# Journal data (personal trading records — not committed)
journal/

# Alpaca / options logs (large)
logs/options/iv_history_cache.json

# Temp / scratch
*.tmp
*.bak
*.swp
